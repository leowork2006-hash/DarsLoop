# Copy to .env.local. All values are empty; localhost/example works without keys.
# Groq speech-to-text: https://console.groq.com/keys
GROQ_API_KEY=
# Google generation/embeddings: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides. Defaults: whisper-large-v3 / gemini-3.5-flash-lite.
ASR_MODEL=
GENERATION_MODEL=
# Supabase Project Settings > API: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Private server/worker key, never use in a browser or commit to Git.
SUPABASE_SECRET_KEY=
# Empty means local mode; hosted authenticated service uses supabase.
DARSLOOP_BACKEND=
# Hosted only: exact HTTPS address with no path. Local default is loopback.
DARSLOOP_ORIGIN=
# Leave empty (PKCE) until the matching hosted email template is installed.
# Only accepted opt-in: token_hash. See docs/email-confirmation.md.
DARSLOOP_EMAIL_CONFIRMATION_FLOW=
# Optional private writable folder, default .data. Host sets PORT.
DARSLOOP_DATA_DIR=
# Local transcript reuse only. Keep private; hosted mode uses the server secret.
DARSLOOP_TRANSCRIPT_CACHE_SECRET=
PORT=
# Optional installed executable paths, default ffmpeg / ffprobe / espeak-ng.
FFMPEG_BIN=
FFPROBE_BIN=
ESPEAK_BIN=

# Manual ASR selection: no automatic provider substitution. Existing started
# lessons retain their provider; new uploads use this setting.
TRANSCRIPTION_PROVIDER=groq
TRANSCRIPTION_CONCURRENCY=2
DEEPGRAM_API_KEY=
SPEECHMATICS_API_KEY=
SPEECHMATICS_REGION=eu1
