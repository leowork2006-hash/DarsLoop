{
  "name": "darsloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "worker": "node --env-file=.env.local --import tsx scripts/worker.ts",
    "worker:local": "node --import tsx scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:audio": "node --import tsx scripts/make-demo-audio.ts",
    "test:api": "node --import tsx scripts/check-api-isolated.ts",
    "test:example": "node --import tsx scripts/check-public-example.ts",
    "start:cloud": "node scripts/start-cloud.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bitter": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@google/genai": "2.27.0",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "busboy": "1.6.0",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/busboy": "1.5.4",
    "@types/node": "26.6.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}
